{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(og.png|favicon.svg|apple-touch-icon.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ],
  "redirects": [
    {
      "source": "/readings",
      "missing": [{ "type": "host", "value": "blogs.happyadav.in" }],
      "destination": "https://blogs.happyadav.in/readings",
      "permanent": true
    },
    {
      "source": "/readings/:slug",
      "missing": [{ "type": "host", "value": "blogs.happyadav.in" }],
      "destination": "https://blogs.happyadav.in/readings/:slug",
      "permanent": true
    },
    {
      "source": "/blog",
      "missing": [{ "type": "host", "value": "blogs.happyadav.in" }],
      "destination": "https://blogs.happyadav.in/readings",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "missing": [{ "type": "host", "value": "blogs.happyadav.in" }],
      "destination": "https://blogs.happyadav.in/readings/:slug",
      "permanent": true
    },
    { "source": "/blog", "destination": "/readings", "permanent": true },
    { "source": "/blog/:slug", "destination": "/readings/:slug", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }]
}
